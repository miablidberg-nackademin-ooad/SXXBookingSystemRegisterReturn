@startuml register_return_activity_diagram
title Registrera återlämning

start

:Visa vald bokning och bokningsuppgifter;
:Visa vilket exemplar som ska återlämnas
och dess inventarienummer;

if (Finns en pågående uthyrning?) then (JA)
    :Personal kontrollerar det
    återlämnade exemplaret;
else (NEJ)
    :Visa felmeddelande om att
    uthyrningen redan är avslutad;
    end
endif

if (Inventarienummret stämmer) then (JA)
    :Kontrollen av exemplaret är klar;
else (NEJ)
    :Visa felmeddelande om fel exemplar;
    :Ingen återlämning registreras;
    end
endif

if (Exemplaret är i godtagbart skick) then (JA)
    :Fortsätt återlämningsprocessen;
else (NEJ)
    :Anropa separat aktivitetsdiagram:
    "Markera exemplar som otillgängligt";
    :Fortsätt återlämningsprocessen
    efter att otillgängligheten hanterats;
endif

:Personal bekräftar återlämningen;

if (Personalen är fortfarande
inloggad och behörig) then (JA)
    :Kontrollera att uthyrningen
    inte redan har avslutats;
else (NEJ)
    :Visa felmeddelande om
    saknad behörighet;
    end
endif

if (Uthyrningen är fortfarande aktiv) then (JA)
    :Registrera återlämningen med koppling
    till exemplaret och personalen;
    :Avsluta den pågående uthyrningen;
    :Behåll det överenskomna bokningspriset;
else (NEJ)
    :Visa meddelande om att
    återlämningen redan registrerats;
    end
endif

if (Registreringen sparades) then (JA)
    :Visa bekräftelse av lyckad registrering av återlämning;
else (NEJ)
    :Visa felmeddelande;
    :Återställ eventuella ofullständiga ändringar;
endif

stop
@enduml